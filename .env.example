# Copy this file to .env and fill in the keys you actually use.
# Nothing here is required -- the openai/anthropic SDKs read their own
# variables automatically, and Wisemonkey falls back to those.

# --- Namespaced per-endpoint keys (recommended when you use several routers) ---
# Wisemonkey tries WM_API_KEY_<PROVIDER> first, then the provider's
# conventional variable, then the generic WM_API_KEY.
# provider: generic   -> OpenRouter, OpenCode, vLLM, any OpenAI-compatible endpoint
# provider: openai    -> api.openai.com
# provider: anthropic -> api.anthropic.com
WM_API_KEY_GENERIC=
WM_API_KEY_OPENAI=
WM_API_KEY_ANTHROPIC=

# Per-endpoint keys of your own choosing. Point at them from config.yaml with
#   model.api_key_env: OPENROUTER_API_KEY
# so several keys coexist without one being sent to the wrong endpoint.
OPENROUTER_API_KEY=
OPENCODE_API_KEY=

# --- Generic fallback, tried last for every provider ---
WM_API_KEY=

# --- Conventional provider variables (existing setups keep working) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
